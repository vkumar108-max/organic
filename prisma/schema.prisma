// STORELAUNCH shared relational schema.
// Used by the Super Admin Panel today; designed to be shared by the Seller Dashboard and Storefront later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  TWO_FACTOR_RECOVERY
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
  REJECTED
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  DISABLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  PAID
  OPEN
  FAILED
  REFUNDED
}

enum ThemeStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NET_BANKING
  WALLET
  BANK_TRANSFER
  COD
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING
  VERIFYING
  VERIFIED
  FAILED
  DISABLED
}

enum SslStatus {
  NONE
  PENDING
  ACTIVE
  FAILED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum MessageAuthorType {
  SELLER
  ADMIN
  SYSTEM
}

// ───────────────────── Admin identity & RBAC ─────────────────────

model User {
  id                 String      @id @default(cuid())
  email              String      @unique
  name               String
  passwordHash       String
  status             AdminStatus @default(ACTIVE)
  emailVerifiedAt    DateTime?
  twoFactorEnabled   Boolean     @default(false)
  twoFactorSecret    String? // encrypted at rest when 2FA is implemented
  failedLoginCount   Int         @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  roles         UserRole[]
  sessions      Session[]
  authTokens    AuthToken[]
  oauthAccounts OAuthAccount[]
  tickets       SupportTicket[] @relation("TicketAssignee")
  auditLogs     AuditLog[]

  @@index([status])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique // sha256 of the cookie token; the raw token is never stored
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. sellers.manage
  group       String
  description String?

  roles RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ───────────────────── Plans, sellers, stores ─────────────────────

model Plan {
  id             String   @id @default(cuid())
  key            String   @unique
  name           String
  description    String?
  monthlyPrice   Decimal  @default(0) @db.Decimal(12, 2)
  yearlyPrice    Decimal  @default(0) @db.Decimal(12, 2)
  trialDays      Int      @default(0)
  productLimit   Int? // null = unlimited
  orderLimit     Int? // per month, null = unlimited
  storageLimitMb Int? // null = unlimited
  features       Json     @default("[]") // string[] of enabled feature keys (catalog in config/plan-features.ts)
  isActive       Boolean  @default(true)
  isPopular      Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sellers       Seller[]
  subscriptions Subscription[]

  @@index([isActive, sortOrder])
}

model Seller {
  id             String       @id @default(cuid())
  code           String       @unique // SLR-1001
  name           String
  email          String       @unique
  phone          String?
  businessName   String?
  country        String?
  city           String?
  address        String?
  status         SellerStatus @default(PENDING)
  statusReason   String?
  planId         String? // current plan (denormalised; subscriptions hold billing detail)
  approvedAt     DateTime?
  lastActivityAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  plan          Plan?          @relation(fields: [planId], references: [id])
  stores        Store[]
  subscriptions Subscription[]
  payouts       Payout[]
  tickets       SupportTicket[]

  @@index([status, createdAt])
  @@index([planId])
  @@index([createdAt])
}

model Store {
  id          String      @id @default(cuid())
  sellerId    String
  themeId     String?
  name        String
  slug        String      @unique
  category    String
  description String?
  status      StoreStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  seller        Seller         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  theme         Theme?         @relation(fields: [themeId], references: [id], onDelete: SetNull)
  customers     Customer[]
  orders        Order[]
  domains       Domain[]
  payouts       Payout[]
  subscriptions Subscription[]
  tickets       SupportTicket[]

  @@index([sellerId])
  @@index([themeId])
  @@index([status, createdAt])
}

// ───────────────────── Subscriptions & billing ─────────────────────

model Subscription {
  id           String             @id @default(cuid())
  code         String             @unique
  sellerId     String
  storeId      String?
  planId       String
  billingCycle BillingCycle       @default(MONTHLY)
  amount       Decimal            @db.Decimal(12, 2)
  status       SubscriptionStatus
  startedAt    DateTime           @default(now())
  trialEndsAt  DateTime?
  renewsAt     DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  seller   Seller                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  store    Store?                @relation(fields: [storeId], references: [id], onDelete: SetNull)
  plan     Plan                  @relation(fields: [planId], references: [id])
  invoices SubscriptionInvoice[]

  @@index([sellerId])
  @@index([storeId])
  @@index([planId])
  @@index([status, renewsAt])
  @@index([createdAt])
}

model SubscriptionInvoice {
  id             String        @id @default(cuid())
  number         String        @unique
  subscriptionId String
  amount         Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  description    String?
  createdAt      DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status, paidAt])
}

// ───────────────────── Themes ─────────────────────

model ThemeCategory {
  id        String @id @default(cuid())
  key       String @unique
  name      String
  sortOrder Int    @default(0)

  themes Theme[]
}

model Theme {
  id              String      @id @default(cuid())
  name            String
  slug            String      @unique
  categoryId      String
  description     String?
  previewImageUrl String?
  version         String      @default("1.0.0")
  status          ThemeStatus @default(DRAFT)
  isActive        Boolean     @default(true)
  isFeatured      Boolean     @default(false)
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  category ThemeCategory @relation(fields: [categoryId], references: [id])
  stores   Store[]

  @@index([categoryId])
  @@index([status, isActive])
}

// ───────────────────── Commerce (platform-level view) ─────────────────────

model Customer {
  id        String         @id @default(cuid())
  storeId   String
  name      String
  email     String
  phone     String?
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, email])
  @@index([createdAt])
  @@index([email])
}

model Order {
  id            String        @id @default(cuid())
  number        String        @unique
  storeId       String
  customerId    String
  subtotal      Decimal       @db.Decimal(12, 2)
  shipping      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  amount        Decimal       @db.Decimal(12, 2) // grand total
  currency      String        @default("USD")
  status        OrderStatus
  paymentStatus PaymentStatus
  placedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  payments Payment[]

  @@index([storeId, placedAt])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  name      String
  sku       String?
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id             String        @id @default(cuid())
  code           String        @unique
  orderId        String
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD")
  method         PaymentMethod
  status         PaymentStatus
  gateway        String? // e.g. "stripe"; never store gateway secrets here
  transactionRef String?       @unique
  failureReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status, createdAt])
  @@index([createdAt])
}

model Payout {
  id            String       @id @default(cuid())
  code          String       @unique
  sellerId      String
  storeId       String?
  grossAmount   Decimal      @db.Decimal(12, 2)
  commission    Decimal      @db.Decimal(12, 2)
  netAmount     Decimal      @db.Decimal(12, 2)
  currency      String       @default("USD")
  status        PayoutStatus @default(PENDING)
  approvedAt    DateTime?
  approvedById  String?
  requestedAt   DateTime     @default(now())
  processedAt   DateTime?
  completedAt   DateTime?
  failureReason String?
  reference     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  store  Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([sellerId])
  @@index([storeId])
  @@index([status, requestedAt])
}

model Domain {
  id                String       @id @default(cuid())
  storeId           String
  hostname          String       @unique
  type              DomainType
  status            DomainStatus @default(PENDING)
  sslStatus         SslStatus    @default(NONE)
  verificationToken String?
  verifiedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([status])
}

// ───────────────────── Support ─────────────────────

model SupportTicket {
  id           String         @id @default(cuid())
  code         String         @unique
  sellerId     String
  storeId      String?
  subject      String
  category     String
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  assignedToId String?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  seller     Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  store      Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  assignedTo User?            @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportMessage[]

  @@index([sellerId])
  @@index([assignedToId])
  @@index([status, priority])
  @@index([updatedAt])
}

model SupportMessage {
  id         String            @id @default(cuid())
  ticketId   String
  authorType MessageAuthorType
  authorName String
  authorId   String? // admin User id when authorType = ADMIN
  body       String
  isInternal Boolean           @default(false) // internal admin note, never shown to the seller
  createdAt  DateTime          @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ───────────────────── Audit & settings ─────────────────────

// Append-only. A DB trigger (see migrations) rejects UPDATE and DELETE.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorEmail  String? // snapshot so history survives user deletion
  action      String
  targetType  String?
  targetId    String?
  description String
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([action])
  @@index([targetType, targetId])
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  group       String
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([group])
}
