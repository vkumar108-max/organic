# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://storelaunch:storelaunch@localhost:5432/storelaunch_admin?schema=public"

# Session cookie / auth
SESSION_TTL_HOURS=12
# Used by `npm run db:seed` to create the first Super Admin (change the password immediately)
BOOTSTRAP_ADMIN_EMAIL="owner@storelaunch.test"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe!12345"
BOOTSTRAP_ADMIN_NAME="Platform Owner"

# Demo data is blocked in production unless this is "true"
ALLOW_DEMO_SEED=false

# Public base URL of the storefront domain used for store previews
STOREFRONT_BASE_DOMAIN="storelaunch.app"

# Secrets handled server-side only. The settings UI only shows whether they are set.
PAYMENT_GATEWAY_KEY_ID=""
PAYMENT_GATEWAY_SECRET=""
SMTP_HOST=""
SMTP_USER=""
SMTP_PASSWORD=""
