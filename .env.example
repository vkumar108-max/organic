# ---- Site -------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="Verdant Roots"
# Comma separated hostnames allowed for next/image (e.g. your CDN)
NEXT_PUBLIC_IMAGE_HOSTS=

# ---- Data source ------------------------------------------------------
# demo  = bundled sample data (src/data/demo). Nothing is persisted.
# live  = talk to the shared backend API (website + mobile app use the same one)
NEXT_PUBLIC_DATA_MODE=demo
# Required when DATA_MODE=live. Server-side only.
BACKEND_API_URL=
BACKEND_API_KEY=

# Set to true ONLY when the catalogue is real; demo sites stay noindex.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ---- Auth (server-side secrets, never NEXT_PUBLIC_) --------------------
AUTH_SECRET=

# ---- Payments (server-side secrets, never NEXT_PUBLIC_) ----------------
# Provider adapter lives in src/lib/payments. Razorpay shown as an example.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Newsletter / email -------------------------------------------------
NEWSLETTER_PROVIDER_API_KEY=
